#!/usr/bin/env bash
set -euo pipefail

z_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$z_root" || ! -f "$z_root/tools/team/z" ]]; then
  printf '请在 Z-from-Moon 仓库里运行这个命令。\n' >&2
  exit 2
fi
cd "$z_root"
z_origin="$(git remote get-url origin 2>/dev/null || true)"
z_repo="${Z_REPO:-$(printf '%s' "$z_origin" | sed -E 's#^https://github\.com/##; s#^git@github\.com:##; s#^ssh://git@github\.com/##; s#\.git$##; s#/$##')}"
z_gh="${Z_GH:-$(command -v gh || true)}"

say() { printf '%s\n' "$*"; }
fail() { printf '✗ %s\n' "$*" >&2; exit 1; }
need_gh() {
  [[ "$z_repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail '无法从 origin 识别 GitHub 仓库；可设置 Z_REPO=owner/name。'
  [[ -n "$z_gh" && -x "$z_gh" ]] || fail '没有找到 GitHub CLI（gh）。请让 agent 按 docs/team/START-HERE.md 安装并登录。'
  "$z_gh" auth status >/dev/null 2>&1 || fail 'GitHub CLI 尚未登录。请运行：gh auth login --hostname github.com --git-protocol https --web'
}
branch() { git branch --show-current; }
login() { "$z_gh" api user --jq .login; }
clean_tree() { [[ -z "$(git status --porcelain)" ]]; }
on_task_branch() { [[ "$(branch)" == task/* ]] || fail "当前分支是 $(branch)。请先在协作面板开工，或运行 tools/team/z start。"; }
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40
}
current_pr() { "$z_gh" pr view "$(branch)" --repo "$z_repo" --json number,url,state,isDraft,mergeStateStatus,statusCheckRollup 2>/dev/null || true; }

dotnet_path() {
  if [[ -n "${Z_DOTNET:-}" ]]; then printf '%s' "$Z_DOTNET"
  elif [[ -x "$z_root/.tooling/project-z/dotnet/dotnet" ]]; then printf '%s' "$z_root/.tooling/project-z/dotnet/dotnet"
  else command -v dotnet || true
  fi
}
has_dotnet() { local z_dotnet; z_dotnet="$(dotnet_path)"; [[ -n "$z_dotnet" ]] && "$z_dotnet" --list-sdks 2>/dev/null | grep -q '^8\.'; }

run_checks() {
  command -v node >/dev/null 2>&1 || fail '需要 Node.js 22（至少 20.19）。'
  say '→ 检查仓库规则'
  node tools/team/project-check.mjs
  say '→ 检查团队自动化'
  if ! z_test_output="$(node --test tools/team/test/*.test.mjs 2>&1)"; then
    printf '%s\n' "$z_test_output"
    fail '团队自动化测试未通过。'
  fi
  if has_dotnet; then
    say '→ 运行 Unity 快速检查'
    (cd unity && Z_DOTNET="$(dotnet_path)" bash Tools/check.sh)
    say '✓ 本地快速检查通过。涉及画面、手感或运行流程时，还要在 Unity 里实际试玩。'
  else
    say '△ 没有 .NET 8 SDK，跳过本地 Unity 快速检查；GitHub 会在合并前完整检查。'
  fi
}

sync_main() {
  on_task_branch
  clean_tree || fail '还有未提交的修改。请先运行 tools/team/z save。'
  say '→ 获取最新 main'
  git fetch origin main
  if git merge-base --is-ancestor origin/main HEAD; then
    say '✓ 已包含最新 main。'
    return
  fi
  if ! git merge --no-edit origin/main; then
    say '✗ 同步时出现冲突。冲突文件：'
    git diff --name-only --diff-filter=U
    say '处理方式：让 agent 理解双方意图后解决冲突，运行 tools/team/z check，再提交合并结果。'
    exit 3
  fi
  say '✓ 已把最新 main 合进当前任务分支。'
}

case "${1:-help}" in
  doctor)
    say "仓库：$z_repo"
    git --version
    [[ -n "$(git config user.name)" && -n "$(git config user.email)" ]] || fail 'Git 还没有署名。请让 agent 设置 git config --global user.name 和 user.email（用 GitHub 显示的 noreply 邮箱即可）。'
    node --version || fail '需要 Node.js 22（至少 20.19）。'
    if has_dotnet; then say '✓ 找到 .NET 8 SDK'; else say '△ 没有 .NET 8 SDK；本地会跳过 Unity 快速检查，GitHub 仍会检查。'; fi
    need_gh
    say "✓ GitHub 账号：$(login)"
    permission="$("$z_gh" api "repos/$z_repo" --jq '.permissions.push')"
    [[ "$permission" == true ]] || fail '这个账号还没有仓库写权限。请联系维护者邀请你，并在邮件或 GitHub 通知中接受邀请。'
    say '✓ 有仓库写权限'
    if [[ -x "/Applications/Unity/Hub/Editor/6000.3.27f1/Unity.app/Contents/MacOS/Unity" ]]; then say '✓ 找到 Unity 6000.3.27f1'; else say '△ 没找到 Unity 6000.3.27f1；改 Unity 场景或试玩前需要安装。'; fi
    ;;
  start)
    shift
    need_gh
    if [[ " $* " != *" --goal "* || " $* " != *" --area "* ]]; then
      fail '用法：tools/team/z start <英文短名> --goal "一句目标" --area <区域ID> [--area <区域ID>]。也可以双击“打开协作面板.command”开工。'
    fi
    Z_GH="$z_gh" node tools/team/task.mjs start "$@"
    ;;
  save)
    shift
    need_gh
    Z_GH="$z_gh" node tools/team/task.mjs save "$@"
    ;;
  still)
    shift
    need_gh
    Z_GH="$z_gh" node tools/team/task.mjs still "$@"
    ;;
  takeover)
    shift
    need_gh
    Z_GH="$z_gh" node tools/team/task.mjs takeover "$@"
    ;;
  panel)
    exec node tools/team/panel/server.mjs
    ;;
  sync)
    sync_main
    ;;
  check)
    run_checks
    ;;
  ship)
    shift
    title=''
    body_file=''
    confirmed=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --title) title="${2:-}"; shift 2 ;;
        --body-file) body_file="${2:-}"; shift 2 ;;
        --confirmed) confirmed+=(--confirmed "${2:-}"); shift 2 ;;
        *) fail "未知参数：$1" ;;
      esac
    done
    need_gh
    on_task_branch
    clean_tree || fail '还有未提交的修改。请先运行 tools/team/z save，或在协作面板点“保存进度”。'
    git fetch origin main
    [[ -n "$(git diff --name-only origin/main...HEAD)" ]] || fail '这个分支和 main 相比还没有文件修改，暂时不能交付。'
    Z_GH="$z_gh" node tools/team/task.mjs ship-check ${confirmed[@]+"${confirmed[@]}"}
    sync_main
    run_checks
    Z_GH="$z_gh" node tools/team/task.mjs ship-check --post ${confirmed[@]+"${confirmed[@]}"}
    git push -u origin HEAD
    pr_state="$("$z_gh" pr view "$(branch)" --repo "$z_repo" --json state --jq .state 2>/dev/null || true)"
    if [[ "$pr_state" == OPEN ]]; then
      "$z_gh" pr ready "$(branch)" --repo "$z_repo" >/dev/null 2>&1 || true
      [[ "$("$z_gh" pr view "$(branch)" --repo "$z_repo" --json isDraft --jq .isDraft)" == false ]] || fail '无法把草稿 PR 转为可合并。请在 PR 页面点 Ready for review。'
      say "✓ 已转为可合并 PR：$("$z_gh" pr view "$(branch)" --repo "$z_repo" --json url --jq .url)"
    elif [[ -n "$pr_state" ]]; then
      fail "这个分支的 PR 已经是 $pr_state。请用 tools/team/z start 开一个新任务分支。"
    else
      [[ -n "$title" ]] || title="$(git log -1 --format=%s)"
      args=(pr create --repo "$z_repo" --base main --head "$(branch)" --title "$title")
      if [[ -n "$body_file" ]]; then args+=(--body-file "$body_file"); else args+=(--body "自动检查通过后会合并。验证结果见本地 tools/team/z check 和 GitHub 检查。"); fi
      url="$("$z_gh" "${args[@]}")"
      say "✓ 已创建 PR：$url"
    fi
    say 'GitHub 会排队检查；通过后自动合并。运行 tools/team/z status 查看进度。'
    ;;
  status)
    need_gh
    say "当前分支：$(branch)"
    pr="$(current_pr)"
    if [[ -z "$pr" ]]; then say '当前分支还没有 PR。'; exit 0; fi
    printf '%s\n' "$pr" | node -e '
      const pr = JSON.parse(require("fs").readFileSync(0, "utf8"));
      const ready = (pr.statusCheckRollup || []).find(item => item.context === "Project Z / Ready");
      console.log(`PR #${pr.number}：${pr.state}${pr.isDraft ? "（草稿）" : ""}`);
      console.log(pr.url);
      console.log(`团队检查：${ready ? `${ready.state} · ${ready.description || ""}` : "等待机器人开始"}`);
    '
    ;;
  done)
    need_gh
    clean_tree || fail '还有未提交的修改，先处理后再回到 main。'
    old="$(branch)"
    git fetch --prune origin
    git switch main
    git merge --ff-only origin/main
    if [[ "$old" == task/* ]]; then
      state="$("$z_gh" pr view "$old" --repo "$z_repo" --json state --jq .state 2>/dev/null || true)"
      if [[ "$state" == MERGED ]]; then git branch -D "$old"; else say "保留本地分支 $old：它的 PR 还没合并。"; fi
    fi
    say '✓ 已回到最新 main。'
    ;;
  help|-h|--help)
    cat <<'HELP'
Z 项目团队命令
  tools/team/z doctor             检查电脑、GitHub 登录和仓库权限
  tools/team/z panel              打开本机协作面板
  tools/team/z start <短名> --goal "目标" --area <区域ID> [--area <区域ID>]
                                  从最新 main 开分支，推送开工提交并创建草稿 PR
  tools/team/z save [--message 说明] [--handoff 交接]
                                  提交并推送当前进度，PR 保持草稿
  tools/team/z still              告诉团队“还在做”，不需要提交代码
  tools/team/z takeover --pr <编号> [--mode continue|fresh] [--note 说明]
                                  接手已搁置任务
  tools/team/z sync               把最新 main 合进当前任务分支
  tools/team/z check              运行本地快速检查
  tools/team/z ship [--confirmed 对方GitHub名]
                                  同步、检查、推送，并把草稿 PR 转为可合并
  tools/team/z status             查看当前 PR 和自动合并状态
  tools/team/z done               合并后回到最新 main
HELP
    ;;
  *) fail "未知命令：$1。运行 tools/team/z help 查看用法。" ;;
esac
