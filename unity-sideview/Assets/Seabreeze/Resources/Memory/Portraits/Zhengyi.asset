    ParamMouthOpenY\uFF1Bsmile/shock/bawl \u5CF0\u503C\u5206\u522B\u4E3A .40/.40/.24\uFF0Csurprise
    \u4E3A .36\uFF1Bbawl \u5148\u7528\u65E0\u6CEA\u54ED\u76F8\uFF0C\u7EA6 1.10 \u79D2\u540E\u5207
    bawl_tears_preview\uFF1B\u5207\u53E5\u5148\u6E05\u7406 ParamDialogueFace\u3001\u89C6\u7EBF\u3001\u7709\u3001\u816E\u7EA2\u3001\u54ED\u76F8\u548C\u53E3\u578B\u3002rendererIndex=1\u3001renderLayer=30\u3001autoFrame=true\u3001visibleHeight=.78\u3001verticalFocus=.62
