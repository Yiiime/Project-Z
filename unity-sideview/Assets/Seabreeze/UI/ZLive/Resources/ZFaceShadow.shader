Shader "UI/ZFaceShadow"
{
    Properties
    {
        [PerRendererData] _MainTex ("Face Atlas Alpha", 2D) = "white" {}
        _Color ("Shadow Tint", Color) = (1, 1, 1, 1)
    }

    SubShader
    {
        Tags
        {
            "Queue" = "Transparent"
            "IgnoreProjector" = "True"
            "RenderType" = "Transparent"
            "PreviewType" = "Plane"
            "CanUseSpriteAtlas" = "True"
        }

        Cull Off
        Lighting Off
        ZWrite Off
        ZTest Always
        Blend SrcAlpha OneMinusSrcAlpha

        Pass
        {
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "UnityCG.cginc"

            sampler2D _MainTex;
            fixed4 _Color;

            struct appdata_t
            {
                float4 vertex : POSITION;
                fixed4 color : COLOR;
                float2 texcoord : TEXCOORD0;
            };

            struct v2f
            {
                float4 vertex : SV_POSITION;
                fixed4 color : COLOR;
                float2 texcoord : TEXCOORD0;
            };

            v2f vert(appdata_t input)
            {
                v2f output;
                output.vertex = UnityObjectToClipPos(input.vertex);
                output.color = input.color * _Color;
                output.texcoord = input.texcoord;
                return output;
            }

            fixed4 frag(v2f input) : SV_Target
            {
                // Sample only the original atlas alpha. The atlas RGB is
                // deliberately ignored so eyes, mouth and hair are never
                // painted a second time by this overlay.
                fixed atlasAlpha = tex2D(_MainTex, input.texcoord).a;
                return fixed4(input.color.rgb, input.color.a * atlasAlpha);
            }
            ENDCG
        }
    }
}
