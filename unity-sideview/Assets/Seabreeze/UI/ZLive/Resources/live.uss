.room { flex-grow: 1; background-color: #e4eae9; color: #35434c; font-size: 13px; }
Label { margin: 0; padding: 0; }
Button { margin: 0; padding: 4px 9px; border-width: 1px; border-color: #8d9ca3; border-radius: 2px; background-color: #fafbf9; color: #35434c; font-size: 12px; -unity-font-style: normal; }
Button:hover { background-color: #e0edf2; border-color: #53647c; }
Button:active { background-color: #cddce8; }
Button:disabled { opacity: 1; color: #687b82; }
.spacer { flex-grow: 1; }
.header { height: 57px; flex-shrink: 0; padding: 7px 20px; flex-direction: row; align-items: center; background-color: #fafbf9; border-bottom-width: 1px; border-bottom-color: #bdc8ca; }
.quiet { border-width: 0; background-color: rgba(0,0,0,0); padding: 3px 5px; font-size: 11px; }
.header > .quiet { margin-right: 14px; }
.avatar { width: 30px; height: 30px; flex-shrink: 0; border-radius: 15px; background-color: #e7e3ef; color: #68718a; -unity-text-align: middle-center; font-size: 13px; border-width: 1px; border-color: #c3bfcf; }
.host-avatar { width: 42px; height: 42px; border-radius: 21px; background-color: #d3cbe5; font-size: 23px; color: #59617d; }
.brand { margin-left: 10px; margin-right: 14px; }
.room-title { font-size: 19px; -unity-font-style: bold; }
.live-label { font-size: 9px; color: #687b82; margin-top: 2px; }
.follow { background-color: #a5d8ee; border-color: #526779; height: 30px; font-size: 12px; }
.stat { font-size: 11px; margin-left: 20px; color: #687b82; }
.body { flex-grow: 1; flex-direction: row; min-height: 0; padding: 9px 15px 7px; }
.stage { flex-grow: 1; flex-basis: 0; min-width: 0; position: relative; overflow: hidden; border-width: 1px; border-color: #8d9ca3; -unity-background-scale-mode: stretch-to-fill; }
.character { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.foreground-clip { position: absolute; top: 79.5%; left: 0; right: 0; bottom: 0; overflow: hidden; }
.foreground-art { position: absolute; left: 0; -unity-background-scale-mode: stretch-to-fill; }
.character-status { white-space: normal; margin: 50px; }
.scene-top { position: absolute; top: 14px; left: 16px; right: 16px; flex-direction: row; align-items: center; }
.scene-badge { background-color: rgba(250,251,249,0.88); border-width: 1px; border-color: #8d9ca3; padding: 5px 10px; font-size: 11px; }
.quality { background-color: rgba(250,251,249,0.76); padding: 4px 8px; color: #526779; font-size: 10px; }
.danmaku-layer { position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; }
.danmaku { position: absolute; white-space: nowrap; font-size: 14px; color: #ffffff; -unity-text-outline-color: rgba(53,67,76,0.7); -unity-text-outline-width: 1px; }
.speech-box { position: absolute; bottom: 60px; left: 20px; right: 20px; height: 88px; padding: 10px 15px; background-color: rgba(250,251,249,0.96); border-width: 1px; border-color: #8d9ca3; border-radius: 2px; }
.speech-heading { flex-direction: row; align-items: center; height: 23px; flex-shrink: 0; margin-bottom: 6px; }
.speaker-z { background-color: #d3cbe5; color: #53647c; width: 35px; height: 21px; -unity-text-align: middle-center; font-size: 13px; border-width: 1px; border-color: #9298ae; }
.mood-label { font-size: 10px; color: #687b82; margin-left: 8px; }
.voice-bars { font-size: 12px; color: #a5bac5; }
.caption-scroll { flex-grow: 1; min-height: 0; }
.caption-scroll .unity-scroller--vertical { width: 5px; }
.caption { font-size: 15px; white-space: normal; color: #35434c; }
.scene-bottom { position: absolute; left: 16px; right: 16px; bottom: 14px; flex-direction: row; align-items: center; height: 30px; }
.location { background-color: rgba(250,251,249,0.82); padding: 5px 8px; font-size: 10px; color: #687b82; }
.icon-button { height: 30px; min-width: 30px; margin-left: 7px; padding: 3px 6px; font-size: 10px; background-color: rgba(250,251,249,0.9); }
.sidebar { width: 302px; flex-shrink: 0; margin-left: 10px; background-color: #fafbf9; border-width: 1px; border-color: #8d9ca3; }
.section-title { flex-direction: row; align-items: center; min-height: 25px; flex-shrink: 0; }
.blue-chip { background-color: #bce1ef; color: #415b6c; padding: 3px 7px; font-size: 12px; -unity-font-style: bold; }
.muted { color: #87949a; font-size: 9px; }
.chat-heading { margin: 13px 14px 6px; }
.agent-status { max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 9px; color: #84919d; }
.chat { flex-grow: 1; min-height: 0; padding: 5px 12px; }
.chat .unity-scroller--vertical { width: 6px; }
.chat-welcome { white-space: normal; font-size: 10px; color: #8a969d; padding: 8px 2px 15px; }
.chat-row { flex-direction: row; padding: 7px 0; flex-shrink: 0; }
.chat-content { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 8px; }
.chat-name { font-size: 10px; color: #8d88a5; margin-bottom: 4px; }
.chat-text { font-size: 12px; white-space: normal; color: #35434c; }
.chat-mine { background-color: #e8f2f5; padding: 7px 4px; }
.chat-tip { height: 36px; flex-shrink: 0; padding: 11px 14px; font-size: 10px; color: #81949e; border-top-width: 1px; border-top-color: #e0e6e5; }
.footer { height: 58px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 9px 20px; background-color: #fafbf9; border-top-width: 1px; border-top-color: #bdc8ca; }
.chat-form { flex-direction: row; align-items: center; width: 300px; height: 38px; border-width: 1px; border-color: #526779; background-color: #ffffff; }
.chat-input { flex-grow: 1; flex-basis: 0; font-size: 12px; margin: 0; }
.chat-input > .unity-text-input { background-color: rgba(0,0,0,0); color: #35434c; border-width: 0; padding: 5px 3px; }
.emoji, .send { width: 31px; height: 32px; border-width: 0; background-color: rgba(0,0,0,0); padding: 0; font-size: 19px; color: #53647c; }
.send { font-size: 17px; }
.like, .share { border-width: 0; background-color: rgba(0,0,0,0); font-size: 15px; margin-left: 16px; color: #84939d; }
.share { font-size: 22px; }
.activity-panel { position: absolute; top: 54px; right: 16px; width: 40%; max-width: 410px; max-height: 65%; padding: 12px; background-color: rgba(250,249,244,0.97); border-width: 1px; border-color: #8d9ca3; border-radius: 2px; }
.activity-panel .unity-scroller--vertical { width: 5px; }
.play-heading { flex-direction: row; align-items: center; margin-bottom: 9px; }
.eyebrow { font-size: 8px; color: #8b91a2; }
.panel-title { font-size: 17px; -unity-font-style: bold; white-space: normal; margin-bottom: 8px; }
.play-question { font-size: 12px; white-space: normal; margin-bottom: 8px; }
.play-status { font-size: 10px; color: #687b82; margin-bottom: 10px; white-space: normal; }
.play-cards { flex-direction: row; justify-content: center; }
.tarot-card { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0 4px; padding: 0; background-color: rgba(0,0,0,0); border-width: 0; }
.tarot-card:hover { background-color: #e8e3ef; }
.card-art { height: 145px; width: 100%; }
.card-label { font-size: 11px; -unity-text-align: middle-center; margin-top: 5px; white-space: normal; }
.card-position { font-size: 9px; -unity-text-align: middle-center; color: #8b91a2; white-space: normal; }
.play-note { white-space: normal; color: #89949a; font-size: 10px; margin: 12px 0; }
.play-actions { flex-direction: row; flex-wrap: wrap; }
.small-button { margin: 3px 5px 0 0; padding: 5px 8px; font-size: 10px; }
.drawing-steps { font-size: 9px; color: #8b91a2; margin: 9px 0; }
.play-dock { position: absolute; left: 16px; top: 53px; flex-direction: row; }
.settings { position: absolute; bottom: 52px; right: 16px; padding: 14px; background-color: #fafbf9; border-width: 1px; border-color: #8d9ca3; }
.pause-overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(238,243,243,0.76); justify-content: center; align-items: center; }
.pause-mark { font-size: 38px; color: #79899a; }
.pause-title { font-size: 17px; margin: 12px 0 17px; }
.toast { position: absolute; bottom: 76px; align-self: center; padding: 10px 18px; border-width: 1px; border-color: #8d9ca3; background-color: #fafbf9; font-size: 12px; }
.chat-input .unity-base-text-field__input { background-color: rgba(0,0,0,0); border-width: 0; border-radius: 0; }
.activity-panel .unity-scroll-view__vertical-scroller { width: 6px; min-width: 6px; }
.activity-panel .unity-scroller__low-button, .activity-panel .unity-scroller__high-button { display: none; }
.control-icon { width: 17px; height: 17px; }
.icon-button { width: 30px; min-width: 30px; justify-content: center; align-items: center; }
.chat-form { width: 245px; }
.card-art { height: 125px; }
.play-note { margin: 8px 0; font-size: 9px; }
.activity-panel { padding: 10px; }
.card-art { height: 90px; }
.activity-panel .panel-title { font-size: 16px; margin-bottom: 6px; }
.play-heading { margin-bottom: 6px; }
.play-note { margin: 5px 0; }
.drawing-panel > .unity-scroll-view__content-viewport { min-height: 0; }
.activity-panel .play-note { display: none; }

/* Keep supporting text readable without enlarging the overall room layout. */
.agent-status { font-size: 10px; color: #53647c; }
.chat-name { font-size: 11px; color: #736b88; }
.chat-text { font-size: 13px; }
.mood-label, .chat-tip, .stat { color: #53647c; }

.call-bar { padding: 10px; border-bottom-width: 1px; border-bottom-color: #dfd7cf; }
.companion-actions { flex-direction: row; flex-wrap: wrap; align-items: center; }
.call-status, .song-note { white-space: normal; font-size: 13px; color: #655c59; margin-top: 5px; margin-bottom: 7px; }
.song-panel { position: absolute; right: 18px; top: 18px; bottom: 18px; width: 460px; max-width: 85%; padding: 18px; background-color: #fff9f2; border-radius: 16px; border-width: 1px; border-color: #e2cbbc; }
.song-request { min-height: 60px; margin-top: 6px; margin-bottom: 8px; }
.song-card { padding: 10px; margin-top: 8px; background-color: #f4e9dd; border-radius: 8px; }
.song-title { white-space: normal; font-size: 16px; color: #463a35; }
.story-choices { margin-top: 6px; }
