.room { flex-grow:1; background-color:#191a2b; color:#f5f2fa; font-size:14px; }
.room Label { color:#f5f2fa; padding:0; margin:0; }
.room Button { margin:0; border-width:1px; border-color:rgba(214,204,255,0.38); border-radius:18px; color:#f5f2fa; background-color:rgba(46,43,66,0.79); padding:3px 10px; }
.room Button:hover { background-color:rgb(76,71,99); }
.room Button:focus { border-color:#c9bafa; }
.room Button:disabled { opacity:0.45; }
.row, .header, .chat-row, .composer, .speech-box, .dialog-actions, .back { flex-direction:row; align-items:center; }
.spacer { flex-grow:1; }
.stage,.character { position:absolute; top:0; bottom:0; left:0; right:0; -unity-background-scale-mode:stretch-to-fill; }
.foreground-clip { position:absolute; top:79.5%; left:0; bottom:0; right:0; overflow:hidden; }
.foreground-art { position:absolute; left:0; -unity-background-scale-mode:stretch-to-fill; }
.header { position:absolute; left:3.2%; top:5.45%; }
.room .host-avatar { width:55px; height:55px; border-radius:28px; border-color:#e8def8; border-width:1px; background-color:rgba(102,115,168,0.53); -unity-text-align:middle-center; font-size:27px; }
.brand { margin-left:13px; align-items:flex-start; }
.room .room-title { font-size:20px; }
.room .live-label { margin-top:4px; padding:2px 10px; border-radius:15px; background-color:#6651e8; font-size:12px; }
.sidebar { position:absolute; top:13.65%; bottom:13.65%; right:4.45%; width:25.8%; min-width:255px; max-width:390px; border-width:1px; border-color:rgba(214,204,255,0.38); border-radius:25px; padding:17px; background-color:rgba(26,27,46,0.82); }
.room .panel-title { font-size:18px; }
.room .count { color:#c9c6dc; margin-left:5px; }
.people { width:17px; height:17px; }
.chat { flex-grow:1; min-height:0; margin:12px 0; }
.chat-row { align-items:flex-start; flex-shrink:0; margin:4px 0 12px 0; }
.avatar { flex-shrink:0; width:30px; height:30px; border-radius:15px; overflow:hidden; }
.portrait { width:100%; height:100%; }
.message-content { flex:1; margin-left:8px; align-items:flex-start; min-width:0; }
.room .nickname { font-size:11px; color:#cdc9de; }
.room .message-text { white-space:normal; max-width:100%; padding:7px 11px; margin-top:4px; background-color:rgba(235,225,255,0.15); border-radius:11px; border-top-left-radius:3px; }
.room .mine .message-text { background-color:rgba(180,169,204,0.65); }
.room .transcript,.room .notice { white-space:normal; color:#ddd8ec; margin:3px 0; }
.composer { min-height:38px; flex-shrink:0; border-width:1px; border-color:rgba(214,204,255,0.55); border-radius:20px; padding:0 5px 0 12px; }
.composer.focused { border-color:#ded2ff; }
.chat-input { flex:1; margin:0; min-width:0; }
.chat-input .unity-base-text-field__input { background-color:rgba(0,0,0,0); color:#f5f2fa; border-width:0; padding:0; }
.controls { margin-top:12px; flex-shrink:0; }
.room .tool { width:31px; height:31px; border-radius:16px; padding:6px; margin-left:6px; align-items:center; justify-content:center; }
.tool-icon,.back-icon { width:16px; height:16px; }
.room .send { background-color:rgba(133,104,203,0.55); border-width:0; }
.room .send:disabled { background-color:rgba(0,0,0,0); }
.room .muted { opacity:0.55; border-color:#8577aa; }
.room .mic-control,.room .back { flex-direction:row; align-items:center; justify-content:center; }
.room .mic-label { margin-left:5px; }
.room .leave-mic { margin-left:4px; padding:3px 7px; }
.room .reopen { position:absolute; right:4.45%; bottom:13.65%; rotate:180deg; }
.room .back { position:absolute; left:3.2%; bottom:5.3%; }
.room .keycap { margin-left:5px; padding:0 3px; border-width:1px; border-color:rgba(214,204,255,0.45); border-radius:3px; font-size:10px; }
.speech-box { position:absolute; left:12%; right:35%; bottom:10%; padding:10px 16px; background-color:rgba(26,27,46,0.84); border-width:1px; border-color:rgba(214,204,255,0.45); border-radius:10px; }
.room .speaker { color:#cab7ff; margin-right:12px; }
.caption-scroll { flex-grow:1; max-height:42px; min-width:0; }
.room .caption { white-space:normal; font-size:16px; }
.dialog-layer { position:absolute; left:0; right:0; top:0; bottom:0; background-color:rgba(12,12,22,0.49); align-items:center; justify-content:center; }
.dialog-paper { width:430px; max-width:85%; padding:28px; background-color:rgba(35,33,53,0.98); border-radius:21px; border-width:1px; border-color:#736b89; }
.room .dialog-title { font-size:22px; }
.room .dialog-copy { white-space:normal; margin:14px 0; color:#dbd6e9; }
.dialog-actions { justify-content:flex-end; margin-top:9px; }
.room .primary,.room .secondary { min-height:34px; padding:4px 15px; margin-left:6px; }
.room .primary { background-color:#6955ab; }
.room .toast { position:absolute; align-self:center; bottom:2%; background-color:#28263a; padding:7px 14px; border-radius:15px; }
.exit-paper { width:350px; padding:28px 40px; align-items:stretch; border-radius:23px; background-color:rgba(29,28,44,0.95); border-color:#5e586f; }
.room .exit-paper .dialog-title { -unity-text-align:middle-center; font-size:19px; }
.exit-paper .dialog-actions { justify-content:space-between; margin-top:20px; }
.room .exit-paper Button { margin:0; width:106px; height:43px; border-radius:23px; font-size:14px; }
.room .exit-paper .primary { color:#ff7488; background-color:#392835; border-color:#59424f; }
.room .exit-paper .secondary { color:#3f394f; background-color:#f5f2fa; border-color:#f5f2fa; }

.room-content { flex-grow:1; }
.blurred { filter:blur(3px); }
.room .blurred .sidebar:disabled,.room .blurred .back:disabled { opacity:1; }
