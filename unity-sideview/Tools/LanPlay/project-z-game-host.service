[Unit]
Description=Project Z shared game services
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/Project-Z/unity-sideview
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node Tools/LanPlay/team-host.mjs start
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
TimeoutStopSec=15

[Install]
WantedBy=default.target
