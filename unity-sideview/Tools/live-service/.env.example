# DeepSeek API key, used only by the local/server text endpoint.
# Copy this entry to DeepSeek配置.env or .env / .env.local. Never put it in browser code.
DEEPSEEK_API_KEY=

# Optional voice: API Key from Volcengine's Doubao Voice NEW console.
# Copy to 火山语音配置.env or .env / .env.local. This is not a Volc Ark LLM key.
VOLC_TTS_API_KEY=

# Native microphone transcription (server only); enable streaming ASR in the same Doubao Voice project.
VOLC_ASR_API_KEY=

# Optional NetEase session file; credentials stay outside source control.
NETEASE_SESSION_FILE=
# Absolute path to FFmpeg, or leave blank to use PATH.
FFMPEG_PATH=
# 0 disables background login maintenance (not singing scheduling).
Z_NETEASE_AUTO_RENEW=1
# Optional existing local diagnostic catalog.
Z_SONG_CATALOG=
