# DeepSeek API key, used only by the local/server text endpoint.
# Copy this entry to DeepSeek配置.env or .env.local. Never put it in browser code.
DEEPSEEK_API_KEY=

# Optional voice: API Key from Volcengine's Doubao Voice NEW console.
# Copy to 火山语音配置.env or .env.local. This is not a Volc Ark LLM key.
VOLC_TTS_API_KEY=

# Doubao streaming ASR 2.0, separate from the Vivi TTS entitlement.
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_KEY=

# RTC / target speaker voiceprint (optional until credentials + enrollment are ready).
# Keep voiceprint mode for the agreed office-noise setup. Enroll only in Settings.
# Use disabled explicitly only when you intend to use ordinary Doubao ASR.
Z_CALL_VOICE_MODE=voiceprint
Z_CALL_ASR_SOURCE=api-key
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
# Leave blank for a new player; Settings enrollment creates data/voiceprint/profile.json.
VOLC_VOICEPRINT_ID=
